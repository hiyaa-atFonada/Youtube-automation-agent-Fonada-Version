# Copy to .env and fill in values. Never commit .env.
#   cp .env.example .env
#
# YouTube OAuth is not set here. Save Client ID / Secret in the dashboard
# (Channel setup) or in config/credentials.json from credentials.example.json.

# --- App ---
NODE_ENV=production
PORT=3456
LOG_LEVEL=info
# Optional. If set, POST/PUT/DELETE routes require header x-api-key.
API_KEY=
MAX_CONCURRENT_JOBS=1

# --- Channel ---
CHANNEL_NAME=Your Channel Name
DEFAULT_AUTHOR=Your Name
TARGET_AUDIENCE=Your target audience
CHANNEL_TIMEZONE=Asia/Kolkata
YOUTUBE_REGION=US
DEFAULT_PRIVACY_STATUS=private
# WEBSITE_URL=https://example.com
# SOCIAL_LINKS=https://x.com/yourhandle
# BUSINESS_EMAIL=you@example.com
# COMPETITOR_CHANNELS=https://www.youtube.com/@example

# --- AI text (pick at least one) ---
# OPENAI_API_KEY=your-openai-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# MOONSHOT_API_KEY=your-kimi-api-key-here
# MIMO_API_KEY=your-mimo-api-key-here
# GLM_API_KEY=your-glm-api-key-here

# --- Fonada (TTS + speaking-style ASR) ---
# FONADA_API_KEY=your-fonada-api-key-here
# FONADA_VOICE=Dhruv
# FONADA_SHARE_ID=abc12xyz
# FONADA_TTS_MODEL=v1
# Spoken language is chosen in the dashboard, not required here.
# FONADA_LANGUAGE=en
# FONADA_ASR_WS_URL=wss://api.fonada.ai/v1/asr/stream
# SPEAKING_STYLE_MAX_MINUTES=8
# SPEAKING_STYLE_DOWNLOAD_TIMEOUT_MS=180000
# SPEAKING_STYLE_JOB_TIMEOUT_MS=720000
# YT_DLP_PATH=
# YT_DLP_COOKIES=

# --- Optional media / TTS fallbacks ---
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# ELEVENLABS_VOICE_ID=your-voice-id-here
# REPLICATE_API_KEY=your-replicate-api-key-here
# AZURE_SPEECH_KEY=your-azure-speech-key-here
# AZURE_SPEECH_REGION=eastus
# FFMPEG_PATH=

# --- Optional alerts ---
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/...

# --- Optional anonymous telemetry (off unless both are set) ---
# ANONYMOUS_TELEMETRY_ENABLED=false
# ANONYMOUS_TELEMETRY_ENDPOINT=https://your-collector.example/events
